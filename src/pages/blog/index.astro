---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout
  title="Writing"
  description="Technical notes, experiments, and lessons from building software."
>
  <Container class="py-20">
    <p class="terminal-kicker">
      <span aria-hidden="true">$ </span>cat ./blog/index
    </p>
    <h1
      class="mt-5 max-w-3xl text-5xl font-semibold tracking-tight sm:text-7xl"
    >
      Notes from the workbench.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
      Technical notes, experiments, and lessons from building software.
    </p>
    <div class="mt-16 border-b border-line">
      {
        posts.map((post) => (
          <PostCard
            href={`/blog/${post.id}/`}
            {...post.data}
            date={post.data.publishedAt}
          />
        ))
      }
    </div>
  </Container>
</BaseLayout>

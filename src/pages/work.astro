---
import ProjectCard from '../components/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';

const projects = [
  {
    title: 'Project one',
    description:
      'Describe the real problem, your technical contribution, and the outcome in one or two sentences.',
    tags: ['TypeScript', 'Astro', 'Product'],
  },
  {
    title: 'Project two',
    description:
      'Use this space for another substantial project, open source contribution, or technical case study.',
    tags: ['Systems', 'API', 'Infrastructure'],
  },
];
---

<BaseLayout
  title="Work"
  description="Selected development work and case studies."
>
  <Container class="py-20">
    <header class="max-w-4xl">
      <p class="terminal-kicker"><span aria-hidden="true">$ </span>ls ./work</p>
      <h1 class="mt-5 text-5xl font-semibold tracking-tight sm:text-7xl">
        Things I have shipped.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
        Selected products, systems, and experiments. Each entry focuses on the
        problem, the decisions, and the result.
      </p>
    </header>

    <div class="mt-16 grid gap-7 md:grid-cols-2">
      {
        projects.map((project, index) => (
          <ProjectCard index={index + 1} {...project} />
        ))
      }
    </div>
  </Container>
</BaseLayout>

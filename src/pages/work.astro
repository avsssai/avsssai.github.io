---
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
---

<BaseLayout title="Work" description="Siva Addanki's development work.">
  <Container class="py-16 sm:py-24">
    <header class="max-w-4xl">
      <h1 class="text-5xl font-normal tracking-tight sm:text-7xl">Work</h1>
    </header>
    <div class="mt-12 border-t border-line py-8">
      <p class="text-muted">Case studies are not published yet.</p>
      <a
        class="mt-6 inline-flex min-h-11 items-center underline underline-offset-4"
        href={site.social.github}>View repositories on GitHub ↗</a
      >
    </div>
  </Container>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import Container from '../components/ui/Container.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <Container>
    <section class="grid min-h-[70vh] content-center gap-12 py-20 lg:grid-cols-[1.35fr_0.65fr] lg:items-end">
      <div>
        <p class="mb-6 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-accent">
          {site.role} · {site.location}
        </p>
        <h1 class="max-w-4xl text-6xl font-semibold leading-[0.94] tracking-[-0.055em] sm:text-7xl lg:text-8xl">
          I build software with a sharp point of view.
        </h1>
      </div>
      <div class="pb-2">
        <p class="text-lg leading-relaxed text-muted">
          {site.description} This is where I share selected work, technical notes, and what I am exploring next.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <ButtonLink href="/work">See my work</ButtonLink>
          <ButtonLink href="/contact" variant="outline">Start a conversation</ButtonLink>
        </div>
      </div>
    </section>

    <section class="border-y border-line py-8" aria-labelledby="principles-heading">
      <h2 id="principles-heading" class="sr-only">How I work</h2>
      <div class="grid gap-8 sm:grid-cols-3">
        <p><span class="font-mono text-xs text-accent">01</span><br /><strong>Useful first.</strong><br /><span class="text-sm text-muted">Solve the real problem before polishing the edges.</span></p>
        <p><span class="font-mono text-xs text-accent">02</span><br /><strong>Simple systems.</strong><br /><span class="text-sm text-muted">Clear boundaries, boring dependencies, strong defaults.</span></p>
        <p><span class="font-mono text-xs text-accent">03</span><br /><strong>Craft in context.</strong><br /><span class="text-sm text-muted">Performance and accessibility are product features.</span></p>
      </div>
    </section>

    <section class="py-20" aria-labelledby="writing-heading">
      <div class="mb-8 flex items-end justify-between gap-6">
        <div>
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-accent">Field notes</p>
          <h2 id="writing-heading" class="mt-3 text-4xl font-semibold tracking-tight">Recent writing</h2>
        </div>
        <ButtonLink href="/blog" variant="text">All posts →</ButtonLink>
      </div>
      {posts.map((post) => <PostCard href={`/blog/${post.id}/`} {...post.data} date={post.data.publishedAt} />)}
    </section>
  </Container>
</BaseLayout>

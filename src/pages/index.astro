---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import PixelCompanion from '../components/PixelCompanion.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import Container from '../components/ui/Container.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <Container>
    <section
      class="grid min-h-[68vh] items-center gap-12 py-20 lg:grid-cols-[1.25fr_0.75fr]"
    >
      <div>
        <p class="terminal-kicker"><span aria-hidden="true">$ </span>whoami</p>
        <h1
          class="mt-6 max-w-4xl text-5xl font-semibold leading-[0.98] tracking-[-0.05em] sm:text-7xl lg:text-8xl"
        >
          I build useful software and write about the process<span
            class="text-accent">_</span
          >
        </h1>
      </div>

      <aside aria-label="About me">
        <PixelCompanion>
          <p>
            hey. i’m <strong>{site.name}</strong>, a {site.role.toLowerCase()} based
            in {site.location}. {site.description}
          </p>
          <p class="mt-3 text-accent">● AVAILABLE FOR INTERESTING PROBLEMS</p>
        </PixelCompanion>
        <div class="mt-8 flex flex-wrap gap-3 lg:pl-[7.25rem]">
          <ButtonLink href="/work/">View work</ButtonLink>
          <ButtonLink href="/blog/" variant="outline">Read blog</ButtonLink>
        </div>
      </aside>
    </section>

    <section class="border-t border-line py-20" aria-labelledby="work-heading">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-5">
        <div>
          <p class="terminal-kicker">~/work</p>
          <h2
            id="work-heading"
            class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl"
          >
            Selected work
          </h2>
        </div>
        <ButtonLink href="/work/" variant="text">All projects →</ButtonLink>
      </div>
      <ProjectCard
        index={1}
        title="Your strongest project"
        description="Lead with the problem you solved, the part you owned, and the result. Replace this placeholder with a concise case study."
        tags={['TypeScript', 'Systems', 'Product']}
        href="/work/"
      />
    </section>

    <section
      class="border-t border-line py-20"
      aria-labelledby="writing-heading"
    >
      <div class="mb-10 flex flex-wrap items-end justify-between gap-5">
        <div>
          <p class="terminal-kicker">~/blog</p>
          <h2
            id="writing-heading"
            class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl"
          >
            Latest notes
          </h2>
        </div>
        <ButtonLink href="/blog/" variant="text">All posts →</ButtonLink>
      </div>
      <div class="border-b border-line">
        {
          posts.map((post) => (
            <PostCard
              href={`/blog/${post.id}/`}
              {...post.data}
              date={post.data.publishedAt}
            />
          ))
        }
      </div>
    </section>
  </Container>
</BaseLayout>

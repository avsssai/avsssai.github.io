---
import { site } from '../config/site';
import Container from './ui/Container.astro';
---

<footer class="mt-24 border-t border-line bg-surface/60 py-8">
  <Container
    class="flex flex-col gap-3 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="font-mono text-xs">
      <span class="text-accent">$</span> © {new Date().getFullYear()}
      {site.name}
    </p>
    <div class="flex gap-5">
      <a class="hover:text-cyan" href={site.social.github}>GitHub</a>
      <a class="hover:text-cyan" href={site.social.linkedin}>LinkedIn</a>
      <a class="hover:text-ink" href="/rss.xml">RSS</a>
    </div>
  </Container>
</footer>

---
import StackFallback from './portfolio/StackFallback.astro';
---

<section
  class="imagination-hero"
  data-stack-experience
  data-stack-scene="static"
  aria-labelledby="hero-heading"
>
  <div class="hero-copy">
    <h1 id="hero-heading">
      Full stack<br /><span class="developer">web developer</span><br />
      <span class="with">with an</span>
      <em>Imagination.</em>
    </h1>
    <a class="work-link" href="/work/"
      >Explore my work <span aria-hidden="true">↗</span></a
    >
  </div>
  <StackFallback />
</section>

<style>
  .imagination-hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 460px;
    width: min(100%, 1720px);
    margin-inline: auto;
    padding: 2rem 1rem 3rem;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    text-align: center;
  }
  h1 {
    margin: 0;
    font: 400 clamp(48px, 6.5vw, 104px)/0.9 var(--font-serif);
    letter-spacing: -0.045em;
  }
  .developer {
    font-size: 1.12em;
  }
  .with {
    font: 500 0.3em/1.8 var(--font-sans);
    letter-spacing: -0.04em;
    vertical-align: middle;
  }
  h1 em {
    font-size: 1.1em;
    font-weight: 400;
  }
  .work-link {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 46px;
    padding: 0.5rem 0.6rem 0.5rem 1.4rem;
    margin-top: 1.75rem;
    border-radius: 99px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 0.75rem;
    text-decoration: none;
  }
  .work-link span {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 1rem;
  }
  .work-link:active {
    opacity: 0.8;
  }
  @media (hover: hover) and (pointer: fine) {
    .work-link:hover {
      outline: 1px solid var(--color-ink);
      outline-offset: 4px;
    }
  }
  @media (max-width: 1000px) and (min-width: 701px) {
    h1 {
      font-size: clamp(50px, 7vw, 73px);
    }
  }
  @media (max-width: 700px) {
    .imagination-hero {
      min-height: 340px;
      padding-block: 3.5rem 4rem;
    }
    h1 {
      font-size: clamp(32px, min(11vw, 6dvh), 68px);
      line-height: 0.97;
    }
    h1 em {
      display: block;
      font-size: 1.36em;
    }
    .with {
      display: block;
      margin-top: 0.5rem;
      font-size: 0.34em;
    }
  }
  @media (max-height: 650px) and (max-width: 700px) {
    .imagination-hero {
      min-height: 300px;
      padding-block: 1.5rem 3rem;
    }
  }
  @media (max-height: 500px) and (max-width: 700px) {
    .imagination-hero {
      min-height: 220px;
      padding-block: 0.5rem;
    }
    .work-link {
      margin-top: 1rem;
    }
  }
  @media (max-height: 500px) and (min-width: 701px) {
    .imagination-hero {
      min-height: 240px;
      padding-block: 1rem;
    }
    h1 {
      font-size: min(6vw, 10dvh);
    }
    .work-link {
      margin-top: 1rem;
    }
  }
  @media (max-width: 1000px), (max-height: 550px) {
    .imagination-hero {
      align-content: center;
      min-height: 0;
      padding-block: 1.5rem;
    }
  }
</style>

<button
  class="theme-switcher"
  hidden
  type="button"
  data-theme-toggle
  aria-label="Switch color theme"
>
  <span class="theme-switcher__icon" aria-hidden="true">◐</span>
  <span class="theme-switcher__label" data-theme-label>Theme</span>
</button>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>(
    '[data-theme-toggle]',
  );
  const label = toggle?.querySelector<HTMLElement>('[data-theme-label]');

  const updateToggle = () => {
    const isDark = root.dataset.theme === 'dark';
    if (label) label.textContent = isDark ? 'Light' : 'Dark';
    toggle?.setAttribute(
      'aria-label',
      `Switch to ${isDark ? 'light' : 'dark'} theme`,
    );
    toggle?.setAttribute('aria-pressed', String(isDark));
    document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
      meta.setAttribute('content', isDark ? '#191918' : '#f6f5f1');
    });
  };

  toggle?.addEventListener('click', () => {
    const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = nextTheme;
    try {
      localStorage.setItem('theme', nextTheme);
    } catch {}
    updateToggle();
  });

  if (toggle) toggle.hidden = false;
  updateToggle();
</script>

<style>
  .theme-switcher[hidden] {
    display: none;
  }
  .theme-switcher {
    display: inline-flex;
    min-height: 44px;
    min-width: 44px;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 0.4rem 0.65rem;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    border-radius: 50px;
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    .theme-switcher:hover {
      border-color: var(--color-accent);
    }
  }

  .theme-switcher:active {
    opacity: 0.7;
  }

  .theme-switcher__icon {
    color: var(--color-magenta);
    font-size: 0.875rem;
  }

  @media (max-width: 30rem) {
    .theme-switcher__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>

---
import { site } from '../config/site';
import ThemeSwitcher from './ThemeSwitcher.astro';
import Container from './ui/Container.astro';

const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/work/', label: 'Work' },
  { href: '/blog/', label: 'Blog' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-line bg-paper/90 backdrop-blur-md"
>
  <Container class="flex min-h-16 items-center justify-between gap-4 py-3">
    <a
      class="font-mono text-sm font-bold tracking-tight hover:text-accent"
      href="/"
      aria-label={`${site.name}, home`}
    >
      <span class="text-accent">~/</span>{
        site.name.toLowerCase().replaceAll(' ', '_')
      }
    </a>
    <div class="flex items-center gap-3 sm:gap-5">
      <nav aria-label="Primary navigation">
        <ul class="flex items-center gap-1 font-mono text-xs sm:gap-2">
          {
            links.map(({ href, label }) => (
              <li>
                <a
                  class:list={[
                    'block border border-transparent px-2 py-2 transition hover:border-line hover:text-accent sm:px-3',
                    isActive(href)
                      ? 'bg-surface font-bold text-accent'
                      : 'text-muted',
                  ]}
                  href={href}
                  aria-current={isActive(href) ? 'page' : undefined}
                >
                  /{label.toLowerCase()}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ThemeSwitcher />
    </div>
  </Container>
</header>

<div class="grid-host" data-grid-host aria-hidden="true"></div>
<div class="grid-instructions" data-grid-instructions hidden>
  <span class="grid-instructions__x" aria-hidden="true">✕</span>
  <button type="button" data-grid-controls aria-describedby="grid-help"
    >Click the grid. I’ll meet you there.</button
  >
  <button
    type="button"
    data-reset-letters
    hidden
    aria-label="Reset Imagination letters">Reset word ↺</button
  >
  <p id="grid-help" class="grid-readable">
    Use the arrow keys to choose a clear spot, then Enter or Space to move
    there. Escape stops the character.
  </p>
</div>
<output
  class="grid-readable"
  data-grid-status
  aria-live="polite"
  aria-atomic="true"></output>
<script>
  import { mountGrid } from './grid-controller';
  const mount = () =>
    document
      .querySelectorAll<HTMLElement>('[data-grid-experience]')
      .forEach(mountGrid);
  mount();
  document.addEventListener('astro:page-load', mount);
  window.addEventListener('pageshow', mount);
</script>
<style is:global>
  .grid-host {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .grid-host canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .grid-instructions {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.25rem 0.5rem;
    width: max-content;
    max-width: calc(100% - 2rem);
    flex-wrap: wrap;
    justify-content: center;
    z-index: 2;
  }
  .grid-instructions button[hidden] {
    display: none;
  }
  .grid-instructions [data-reset-letters] {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .grid-instructions[hidden] {
    display: none;
  }
  .grid-instructions__x {
    color: #df4439;
    font-size: 1.25rem;
    transform: rotate(-8deg);
  }
  .grid-instructions button {
    min-height: 44px;
    border: 0;
    background: transparent;
    padding: 0.4rem 0.1rem;
    color: #68665f;
    font: 400 0.75rem var(--font-sans);
  }
  .grid-instructions button:active {
    color: #252523;
  }
  .grid-readable {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .grid-actors {
    position: fixed;
    inset: 0;
    z-index: 4;
    overflow: clip;
    pointer-events: none;
  }
  .grid-character {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    pointer-events: none;
  }
  .grid-character > svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .grid-marker {
    position: absolute;
    left: 0;
    top: 0;
    width: 38px;
    height: 38px;
    pointer-events: none;
  }
  .grid-marker[hidden] {
    display: none;
  }
  .grid-marker svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

---
interface Props {
  documentMode?: boolean;
}
const { documentMode = false } = Astro.props;
---

<div class="grid-host" data-grid-host aria-hidden="true"></div>
<div
  class:list={[
    'grid-instructions',
    { 'grid-instructions--document': documentMode },
  ]}
  data-grid-instructions
  hidden
>
  <span class="grid-instructions__x" aria-hidden="true">✕</span>
  <button type="button" data-grid-controls aria-describedby="grid-help"
    >{
      documentMode
        ? 'Click a clear spot. I’ll meet you there.'
        : 'Click the grid. I’ll meet you there.'
    }</button
  >
  <button
    type="button"
    data-reset-letters
    hidden
    aria-label="Reset headline and Imagination">Reset text ↺</button
  >
  <p id="grid-help" class="grid-readable">
    Use the arrow keys to choose a clear spot, then Enter or Space to move
    there. Escape stops the character.
  </p>
</div>
<output
  class="grid-readable"
  data-grid-status
  aria-live="polite"
  aria-atomic="true"></output>
<script>
  import { mountGrid } from './grid-controller';
  const mount = () =>
    document
      .querySelectorAll<HTMLElement>('[data-grid-experience]')
      .forEach(mountGrid);
  mount();
  document.addEventListener('astro:page-load', mount);
  window.addEventListener('pageshow', mount);
</script>
<style is:global>
  .grid-invitation {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 5;
    width: 164px;
    height: 128px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #c83b31;
    text-align: left;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  :root[data-theme='dark'] .grid-invitation {
    color: #ff9684;
  }
  .grid-invitation[hidden],
  .grid-first-arrival[hidden] {
    display: none;
  }
  .grid-invitation:focus-visible {
    outline: 2px dashed currentColor;
    outline-offset: 5px;
    border-radius: 12px;
  }
  .grid-invitation__copy {
    position: absolute;
    top: 0;
    left: 44px;
    transform: rotate(-7deg);
    transform-origin: bottom left;
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .grid-invitation strong {
    display: block;
    font:
      italic 600 25px/1.1 Georgia,
      serif;
    letter-spacing: -0.06em;
  }
  .grid-invitation small {
    display: block;
    margin-top: 3px;
    color: var(--color-ink);
    font:
      italic 15px/1.2 Georgia,
      serif;
  }
  .grid-invitation > svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .grid-invitation > .grid-invitation__compact-arrow {
    display: none;
  }
  .grid-invitation--compact {
    height: 48px;
  }
  .grid-invitation--compact .grid-invitation__copy {
    top: 2px;
    left: 52px;
    transform: rotate(-4deg);
  }
  .grid-invitation--compact strong {
    font-size: 22px;
  }
  .grid-invitation--compact small {
    margin-top: 1px;
    font-size: 13px;
  }
  .grid-invitation--compact > .grid-invitation__arrow {
    display: none;
  }
  .grid-invitation--compact > .grid-invitation__compact-arrow {
    display: block;
  }
  .grid-invitation:active .grid-invitation__copy {
    transform: rotate(-4deg) scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .grid-invitation:hover .grid-invitation__copy {
      transform: rotate(-3deg);
    }
  }
  .grid-first-arrival {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 5;
    width: 160px;
    padding: 9px 10px;
    border: 1.5px solid var(--color-ink);
    border-radius: 14px 16px 15px 3px;
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: 2px 3px 0 var(--color-ink);
    font:
      italic 17px/1.2 Georgia,
      serif;
    text-align: center;
    pointer-events: none;
  }
  @media (max-width: 360px) {
    .grid-first-arrival {
      width: 132px;
      padding: 7px 6px;
      font-size: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .grid-invitation__copy {
      transition: none;
    }
  }
  .grid-host {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .grid-host canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .grid-instructions {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.25rem 0.5rem;
    width: max-content;
    max-width: calc(100% - 2rem);
    flex-wrap: wrap;
    justify-content: center;
    z-index: 2;
  }
  .grid-instructions--document {
    position: relative;
    bottom: auto;
    left: auto;
    transform: none;
    margin: 1rem auto;
  }
  .grid-instructions button[hidden] {
    display: none;
  }
  .grid-instructions [data-reset-letters] {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .grid-instructions[hidden] {
    display: none;
  }
  .grid-instructions__x {
    color: #df4439;
    font-size: 1.25rem;
    transform: rotate(-8deg);
  }
  .grid-instructions button {
    min-height: 44px;
    border: 0;
    background: transparent;
    padding: 0.4rem 0.1rem;
    color: var(--color-muted);
    font: 400 0.75rem var(--font-sans);
  }
  .grid-instructions button:active {
    color: var(--color-ink);
  }
  .grid-readable {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .grid-actors {
    position: fixed;
    inset: 0;
    z-index: 4;
    overflow: clip;
    pointer-events: none;
  }
  .grid-character {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    pointer-events: none;
  }
  .grid-character > svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .grid-marker {
    position: absolute;
    left: 0;
    top: 0;
    width: 38px;
    height: 38px;
    pointer-events: none;
  }
  .grid-marker[hidden] {
    display: none;
  }
  .grid-marker svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

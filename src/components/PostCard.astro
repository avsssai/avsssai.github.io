---
interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  tags?: string[];
}

const { href, title, description, date, tags = [] } = Astro.props;
---

<article class="group border-t border-line py-7">
  <a class="grid gap-3 sm:grid-cols-[1fr_auto] sm:gap-8" href={href}>
    <div>
      <h2 class="text-xl font-semibold tracking-tight transition group-hover:text-accent">{title}</h2>
      <p class="mt-2 max-w-2xl text-muted">{description}</p>
      {tags.length > 0 && <p class="mt-3 font-mono text-xs text-muted">{tags.join(' · ')}</p>}
    </div>
    <time class="font-mono text-xs text-muted" datetime={date.toISOString()}>
      {date.toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric' })}
    </time>
  </a>
</article>

<section class="game-launcher pixel-panel" data-game-launcher>
  <header class="game-launcher__bar">
    <div>
      <span class="game-launcher__light game-launcher__light--pink"></span>
      <span class="game-launcher__light game-launcher__light--green"></span>
      <span class="game-launcher__light game-launcher__light--cyan"></span>
    </div>
    <span>AGENT_RUNNER.EXE</span>
    <span>BUILD 1.0</span>
  </header>

  <div class="game-launcher__screen" data-game-stage>
    <div class="game-launcher__briefing">
      <p class="terminal-kicker">MISSION BRIEF</p>
      <h2>Defend the core.<br />Ship the sprint.</h2>
      <p>
        Tickets are coming from every direction. Deploy agents across three
        lanes; they'll lock on to nearby threats while you manage energy and
        protect the core.
      </p>

      <dl>
        <div><dt>Threats</dt><dd>4 directions + flyers</dd></div>
        <div><dt>Agents</dt><dd>360° auto targeting</dd></div>
        <div><dt>Mission</dt><dd>90 second survival</dd></div>
      </dl>

      <button type="button" data-game-boot>
        <span aria-hidden="true">▶</span> Launch mission
      </button>
      <p class="game-launcher__status" data-game-status aria-live="polite">
        Arrow keys select lanes. Space deploys. Tap the arena to do both.
      </p>
    </div>
  </div>
</section>

<script>
  const launcher = document.querySelector<HTMLElement>('[data-game-launcher]');
  const button = launcher?.querySelector<HTMLButtonElement>('[data-game-boot]');
  const stage = launcher?.querySelector<HTMLElement>('[data-game-stage]');
  const status = launcher?.querySelector<HTMLElement>('[data-game-status]');

  button?.addEventListener(
    'click',
    async () => {
      if (!stage || !status) return;

      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      status.textContent = 'Loading game chunk…';

      try {
        const { bootMissionPreview } = await import('../game/boot');
        stage.replaceChildren();
        stage.classList.add('game-launcher__screen--active');
        bootMissionPreview(stage);
        status.textContent = 'Mission online.';
      } catch (error) {
        button.disabled = false;
        button.removeAttribute('aria-busy');
        status.textContent = 'Boot failed. Reload and try again.';
        console.error(error);
      }
    },
    { once: true },
  );
</script>


---
interface Props {
  index: number;
  title: string;
  description: string;
  tags: string[];
  href?: string;
}

const { index, title, description, tags, href } = Astro.props;
---

<article class="pixel-panel group flex min-h-72 flex-col p-6 sm:p-8">
  <div class="flex items-center justify-between font-mono text-xs">
    <span class="text-accent">PROC_{String(index).padStart(2, '0')}</span>
    <span class="text-muted">STATUS: SHIPPED</span>
  </div>
  <h2
    class="mt-14 text-3xl font-semibold tracking-tight transition group-hover:text-cyan"
  >
    {title}
  </h2>
  <p class="mt-3 max-w-xl leading-relaxed text-muted">{description}</p>
  <p class="mt-auto pt-8 font-mono text-xs text-magenta">
    [{tags.join('] [')}]
  </p>
  {
    href && (
      <a
        class="mt-5 font-mono text-xs font-bold text-cyan hover:underline"
        href={href}
      >
        OPEN_PROJECT →
      </a>
    )
  }
</article>

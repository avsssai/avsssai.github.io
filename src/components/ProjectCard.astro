---
interface Props {
  index: number;
  title: string;
  description: string;
  tags: string[];
  href?: string;
}

const { index, title, description, tags, href } = Astro.props;
---

<article class="pixel-panel group flex min-h-72 flex-col p-6 sm:p-8">
  <p class="text-xs text-muted">{String(index).padStart(2, '0')}</p>
  <h2 class="mt-8 text-3xl font-medium tracking-tight">
    {title}
  </h2>
  <p class="mt-3 max-w-xl leading-relaxed text-muted">{description}</p>
  <p class="mt-auto pt-8 text-xs text-muted">{tags.join(' · ')}</p>
  {
    href && (
      <a
        class="mt-5 inline-flex min-h-11 items-center text-sm underline underline-offset-4"
        href={href}
      >
        View project ↗
      </a>
    )
  }
</article>

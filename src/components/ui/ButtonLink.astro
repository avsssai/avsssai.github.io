---
interface Props {
  href: string;
  variant?: 'solid' | 'outline' | 'text';
  class?: string;
}

const { href, variant = 'solid', class: className = '' } = Astro.props;
const styles = {
  solid:
    'border border-accent bg-accent text-paper shadow-[3px_3px_0_var(--pixel-shadow)] hover:-translate-x-0.5 hover:-translate-y-0.5',
  outline:
    'border border-line bg-surface text-ink shadow-[3px_3px_0_var(--pixel-shadow)] hover:border-accent hover:text-accent',
  text: 'text-cyan underline decoration-line underline-offset-4 hover:decoration-cyan',
};
---

<a
  class:list={[
    'inline-flex min-h-11 items-center justify-center px-5 font-mono text-xs font-bold uppercase tracking-wider transition active:translate-x-[3px] active:translate-y-[3px] active:shadow-none',
    styles[variant],
    className,
  ]}
  href={href}
>
  <slot />
</a>
